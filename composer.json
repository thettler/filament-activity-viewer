{
    "name": "thettler/filament-activity-viewer",
    "description": "Spatie activity log integration for FilamentPHP which lets you view and search your activity Logs",
    "keywords": [
        "thettler",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "filament-activity-viewer"
    ],
    "homepage": "https://github.com/thettler/filament-activity-viewer",
    "support": {
        "issues": "https://github.com/thettler/filament-activity-viewer/issues",
        "source": "https://github.com/thettler/filament-activity-viewer"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Hettler",
            "email": "tobias.hettler@bitbench.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "8.5",
        "donatj/phpuseragentparser": "^1.11",
        "filament/filament": "^5.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Thettler\\FilamentActivityViewer\\": "src/",
            "Thettler\\FilamentActivityViewer\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Thettler\\FilamentActivityViewer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Thettler\\FilamentActivityViewer\\FilamentActivityViewerServiceProvider"
            ],
            "aliases": {
                "FilamentActivityViewer": "Thettler\\FilamentActivityViewer\\Facades\\FilamentActivityViewer"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
